{
  "manifest_version": 3,
  "name": "投递助手",
  "version": "0.4.4",
  "description": "从岗位网页采集 JD，并可用 AI 补全公司与组织信息。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.deepseek.com/*", "https://api.openai.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "记录当前岗位",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "dashboard.html"
}
